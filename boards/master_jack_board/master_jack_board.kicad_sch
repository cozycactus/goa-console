  (text "JACK BOARD  panel jacks under the panel (~24 mm deep); 2x20 IDC ribbon to the main board, pin = conductor"
    (at 30.48 31.75 0)
    (effects (font (size 2.0 2.0)) (justify left))
    (uuid 0216dc42-3b43-5008-bffe-b9833f817f1c)
  )
  (text "H: plated M3 standoffs, they bond CHASSIS (the sleeves, XLR pin 1 and shell) to the panel."
    (at 40.64 140.462 0)
    (effects (font (size 1.27 1.27)) (justify left))
    (uuid f53ef122-2d2a-5b51-97b9-cfa6022e94a3)
  )
  (text "Insert: tip = send, ring = return; unplugged, the ring normal puts the send on the return."
    (at 40.64 143.256 0)
    (effects (font (size 1.27 1.27)) (justify left))
    (uuid 3bf49550-d7b9-5991-9db6-248501288146)
  )
  (text "L in: its normals put tip and ring on GNDA when nothing is plugged in."
    (at 40.64 146.05 0)
    (effects (font (size 1.27 1.27)) (justify left))
    (uuid 0899af8b-0cfe-5525-b4ed-bb9a7fc67901)
  )
  (text "R in: its normals take the L jack's tip and ring (R normalled to L)."
    (at 40.64 148.844 0)
    (effects (font (size 1.27 1.27)) (justify left))
    (uuid 2b8fb3f3-3c69-5b34-9457-e6808cff656f)
  )

