    (effects (font (size 1.27 1.27)) (justify left))
    (uuid 3dc785d9-fa60-5ff0-972a-2c8ca4e4358d)
  )
  (text "   the tabs sit at +17 V (U1), 0 V (U3) and the rails (SCR anodes). U1 and U3: 19 W each at 4 A,"
    (at 213.36 298.247 0)
    (effects (font (size 1.27 1.27)) (justify left))
    (uuid 557bfbf2-6acd-5f03-adb0-405bbe7439a9)
