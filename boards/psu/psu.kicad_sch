  (text "POS CROWBAR  TL431 at 66K5 / 10K = 19.1 V -> PNP -> SCR gate; SCR 2N6505G across the rail"
    (at 30.48 104.14 0)
    (effects (font (size 2.0 2.0)) (justify left))
    (uuid 88ef3d06-d382-554c-8835-1dfebaf49d93)
  )
  (text "J1: LRS-150-24 #1 (+ pin 1, - pin 2), set to" (at 29.21 86.919 0)
    (effects (font (size 1.27 1.27)) (justify left))
    (uuid 1e63fe75-a9b6-53be-a798-3e47953a3c41)
  )
  (text "21.6 V; 150 mV pk-pk ripple at about 65 kHz;" (at 29.21 89.459 0)
    (effects (font (size 1.27 1.27)) (justify left))
    (uuid c124b942-d8b1-59c0-8014-cdc5c81ece61)
  )
  (text "5.1 A peak at start-up (its limit: >= 6.8 A)." (at 29.21 91.999 0)
    (effects (font (size 1.27 1.27)) (justify left))
    (uuid d455e92f-ae3a-5297-bc96-55ffb3e73f27)
  )
  (text "L1 / C1: -47 dB, 0.7 mV pk-pk at the LDO input." (at 29.21 94.539 0)
    (effects (font (size 1.27 1.27)) (justify left))
    (uuid 20da50b9-d29e-5c7a-8acc-44b42d144071)
  )
  (text "VO = 1.25 V x (1 + 1K5 / 120R) + 55 uA x 1K5" (at 88.9 86.919 0)
    (effects (font (size 1.27 1.27)) (justify left))
    (uuid 90af1ccb-d94b-5a65-8ab3-37698b43cfde)
  )
  (text "   = 17.0 V; 120R is also U1's 10 mA minimum load."
