    (effects (font (size 1.27 1.27)) (justify left))
    (uuid 50b52ecb-f360-50ec-936a-f9a0642fe530)
  )
  (text "Layout: the 4 A paths (J1 / J2 -> L -> LDO -> J3) want >= 3 mm tracks or pours on both layers."
