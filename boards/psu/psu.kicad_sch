    (effects (font (size 1.27 1.27)) (justify left))
    (uuid 384cb6c0-193d-50c8-a586-1ebbb203d53b)
  )
  (text "C3: soft start: 10 % at 5 ms, 90 % at 165 ms." (at 88.9 91.999 0)
