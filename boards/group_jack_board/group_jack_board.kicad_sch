  (text "Insert: tip = send, ring = return; unplugged, the ring normal puts the send on the return."
    (at 40.64 153.416 0)
    (effects (font (size 1.27 1.27)) (justify left))
    (uuid 357d1695-7797-5e98-b7d0-a5ca4ee5f2de)
  )
  (text "L in: its normals put tip and ring on GNDA when nothing is plugged in."
    (at 40.64 156.21 0)
    (effects (font (size 1.27 1.27)) (justify left))
    (uuid 48ddf819-1864-57e6-bb73-19010ef7db37)
  )
  (text "R in: its normals take the L jack's tip and ring (R normalled to L)."
    (at 40.64 159.004 0)
    (effects (font (size 1.27 1.27)) (justify left))
    (uuid dc679237-66a5-55ec-85b7-8f77e527c16a)
  )

