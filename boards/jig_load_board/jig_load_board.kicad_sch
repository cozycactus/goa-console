    (effects (font (size 2.0 2.0)) (justify left))
    (uuid feed0347-396d-5b8c-8ef6-8582467ad379)
  )
  (text "DUMMY CHANNELS  per bus, groups of 1 / 3 / 4 / 12 channels as one equivalent resistor (same noise and noise gain);"
